crosoft YaHei;fontSize=32;fontColor=#176622;fontStyle=1;fillColor=#edf7ed;strokeColor=#176622;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="496.6666666666667" y="1096" width="446.6666666666667" height="132" as="geometry" /></mxCell><mxCell id="65" parent="1" value="T4～T5：再转发 B0、B1&#10;B1 携带 WLAST=1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#176622;fontStyle=1;fillColor=#edf7ed;strokeColor=#176622;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="963.3333333333334" y="1096" width="446.6666666666667" height="132" as="geometry" /></mxCell><mxCell id="66" parent="1" value="下游 AW 事务顺序为 A → B，因此下游 W 数据必须为 A0 → A1 → B0 → B1；不能让 B 越过 A。" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#123a91;fontStyle=1;fillColor=#ffffff;strokeColor=#123a91;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="1256" width="1380" height="92" as="geometry" /></mxCell><mxCell id="67" parent="1" value="AXI4 的 W 通道没有 WID，不能交织成 A0 → B0 → A1 → B1。AXI3 曾允许不同 ID 的写数据交织。" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#743c98;fontStyle=1;fillColor=#ffffff;strokeColor=#743c98;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="1371" width="1380" height="92" as="geometry" /></mxCell><mxCell id="68" parent="1" value="“地址顺序”是 AW 事务的转发顺序，不是地址值排序。本例 A=0x2000、B=0x1000；两笔均为 2 拍 INCR，且无背压。" vertex="1" style="rounded=0;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#697586;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="1484" width="1380" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>