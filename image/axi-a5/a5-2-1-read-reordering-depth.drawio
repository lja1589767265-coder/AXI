"geometry" /></mxCell><mxCell id="60" parent="1" edge="1" style="endArrow=none;endFill=1;startArrow=none;rounded=0;strokeWidth=2;strokeColor=#697586;dashed=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="927.1818181818181" y="989" as="sourcePoint" /><mxPoint x="1410" y="989" as="targetPoint" /></mxGeometry></mxCell><mxCell id="61" parent="1" value="RLAST" vertex="1" style="rounded=0;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#743c98;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=2;align=left;verticalAlign=middle;spacing=8;"><mxGeometry x="12" y="1045" width="215" height="55" as="geometry" /></mxCell><mxCell id="62" parent="1" edge="1" style="endArrow=none;endFill=1;startArrow=none;rounded=0;strokeWidth=3;strokeColor=#743c98;dashed=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="1089" as="sourcePoint" /><mxPoint x="1410" y="1089" as="targetPoint" /><Array as="points"><mxPoint x="515.7272727272727" y="1089" /><mxPoint x="527.7272727272727" y="1053" /><mxPoint x="921.1818181818181" y="1053" /><mxPoint x="933.1818181818181" y="1089" /></Array></mxGeometry></mxCell><mxCell id="63" parent="1" value="T1：接收 A，ARID=1&#10;A 进入待处理集合" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#123a91;fontStyle=1;fillColor=#edf4ff;strokeColor=#123a91;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30.0" y="1178" width="446.6666666666667" height="132" as="geometry" /></mxCell><mxCell id="64" parent="1" value="T2：接收 B，ARID=2&#10;此后共有 2 笔待处理地址" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#123a91;fontStyle=1;fillColor=#edf4ff;strokeColor=#123a91;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="496.6666666666667" y="1178" width="446.6666666666667" height="132" as="geometry" /></mxCell><mxCell id="65" parent="1" value="T3～T4：先返回 B，再返回 A&#10;在两笔事务范围内发生重排" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#743c98;fontStyle=1;fillColor=#f3eef9;strokeColor=#743c98;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="963.3333333333334" y="1178" width="446.6666666666667" height="132" as="geometry" /></mxCell><mxCell id="66" parent="1" value="重排深度为 2：从设备能够在两笔待处理读地址的范围内调整返回次序；不表示每次都必须乱序。" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#123a91;fontStyle=1;fillColor=#ffffff;strokeColor=#123a91;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="1338" width="1380" height="92" as="geometry" /></mxCell><mxCell id="67" parent="1" value="若重排深度为 1，从设备按序处理所有事务，只能先返回 A、再返回 B。相同 ID 的事务也始终必须保序。" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#743c98;fontStyle=1;fillColor=#ffffff;strokeColor=#743c98;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="1453" width="1380" height="92" as="geometry" /></mxCell><mxCell id="68" parent="1" value="重排深度是设计者声明的静态能力，主设备不能通过 AXI 信号查询。A=0x1000，B=0x2000，ARLEN=0，RRESP=OKAY。" vertex="1" style="rounded=0;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#697586;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="1566" width="1380" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>