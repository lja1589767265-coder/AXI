1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b42;fontStyle=0;fillColor=#f6f8fa;strokeColor=#27364a;strokeWidth=2;align=left;verticalAlign=middle;spacing=12;"><mxGeometry x="410" y="789" width="995" height="135" as="geometry" /></mxCell><mxCell id="25" value="AWCACHE" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b42;fontStyle=1;fillColor=#ffffff;strokeColor=#27364a;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;"><mxGeometry x="35" y="924" width="190" height="105" as="geometry" /></mxCell><mxCell id="26" value="Master" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b42;fontStyle=0;fillColor=#ffffff;strokeColor=#27364a;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;"><mxGeometry x="225" y="924" width="185" height="105" as="geometry" /></mxCell><mxCell id="27" value="指示写 transaction 必须如何在系统中推进。&#10;参见第 A4-69 页的“内存类型”。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b42;fontStyle=0;fillColor=#ffffff;strokeColor=#27364a;strokeWidth=2;align=left;verticalAlign=middle;spacing=12;"><mxGeometry x="410" y="924" width="995" height="105" as="geometry" /></mxCell><mxCell id="28" value="AWPROT" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b42;fontStyle=1;fillColor=#f6f8fa;strokeColor=#27364a;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;"><mxGeometry x="35" y="1029" width="190" height="118" as="geometry" /></mxCell><mxCell id="29" value="Master" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b42;fontStyle=0;fillColor=#f6f8fa;strokeColor=#27364a;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;"><mxGeometry x="225" y="1029" width="185" height="118"