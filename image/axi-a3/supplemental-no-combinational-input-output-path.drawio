=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#172b42;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="80" y="500" width="380" height="34" as="geometry" /></mxCell><mxCell id="27" value="两个组件互连后，输入与输出的&#10;组合依赖可能首尾相接。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b42;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="80" y="540" width="380" height="72" as="geometry" /></mxCell><mxCell id="28" value="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#172b42;fontStyle=0;fillColor=#f6f8fa;strokeColor=#a7b0bd;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="510" y="485" width="420" height="145" as="geometry" /></mxCell><mxCell id="29" value="缩短跨组件时序路径" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#172b42;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="530" y="500" width="380" height="34" as="geometry" /></mxCell><mxCell id="30" value="组合路径不会穿过多个接口级联，&#10;更容易满足 ACLK 时序。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b42;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="530" y="540" width="380" height="72" as="geometry" /></mxCell><mxCell id="31" value="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#172b42;fontStyle=0;fillColor=#f6f8fa;strokeColor=#a7b0bd;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="960" y="485" width="420" height="145" as="geometry" /></mxCell><mxCell id="32" value="保证握手信号稳定" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#172b42;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="980" y="500" width="380" height="34" as="geometry" /></mxCell><mxCell id="33" value="VALID、READY 在采样边沿前稳定，&#10;避免毛刺或不确定状态传播。" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b42;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="980" y="540" width="380" height="72" as="geometry" /></mxCell><mxCell id="34" value="典型错误例子：VALID 与 READY 形成组合环路" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#b42318;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="60" y="660" width="1320" height="42" as="geometry" /></mxCell><mxCell id="35" value="Master 组合逻辑&#10;request：内部已有待发送请求&#10;（非 AXI 接口信号）&#10;VALID = request AND READY" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b42;fontStyle=1;fillColor=#fff7f7;strokeColor=#d85b5b;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="150" y="730" width="400" height="150" as="geometry" /></mxCell><mxCell id="36" value="Slave 组合逻辑&#10;space：内部有可用接收空间&#10;（非 AXI 接口信号）&#10;READY = space AND VALID" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b42;fontStyle=1;fillColor=#fff7f7;strokeColor=#d85b5b;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="890" y="730" width="400" height="150" as="geometry" /></mxCell><mxCell id="37" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=1;fontColor=#172b42;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="550" y="760" width="1" height="1" as="geometry" /></mxCell><mxCell id="38" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=1;fontColor=#172b42;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="889" y="760" width="1" height="1" as="geometry" /></mxCell><mxCell id="39" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=1;fontColor=#172b42;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="890" y="840" width="1" height="1" as="geometry" /></mxCell><mxCell id="40" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=1;fontColor=#172b42;fontStyle=0;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="549" y="840" width="1" height="1" as="geometry" /></mxCell><mxCell id="41" edge="1" parent="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#b42318;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=classic;endFill=1;" source="37" target="38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="42" edge="1" parent="1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#b42318;strokeWidth=3;dashed=0;startArrow=none;startFill=1;endArrow=classic;endFill=1;" source="39" target="40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="43" value="VALID" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#b42318;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="650" y="720" width="240" height="32" as="geometry" /></mxCell><mxCe