<?xml version='1.0' encoding='utf-8'?>
<mxfile host="draw.io"><diagram name="Device 写：怎样确认前序写已到达"><mxGraphModel page="1" pageWidth="1080" pageHeight="990"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" value="" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fillColor=#ffffff;strokeColor=none;"><mxGeometry x="0" y="0" width="1080" height="990" as="geometry" /></mxCell><mxCell id="3" parent="1" value="Device 写：怎样确认前序写已到达" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=38;fontColor=#172b42;fontStyle=1;"><mxGeometry x="30" y="20" width="1020" height="55" as="geometry" /></mxCell><mxCell id="4" parent="1" value="前提：AXI4；同一主设备、同一 ID、同一从设备。&#10;这是顺序关系图，不是波形；没有固定拍数含义。" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fontStyle=0;"><mxGeometry x="30" y="90" width="1020" height="100" as="geometry" /></mxCell><mxCell id="5" parent="1" value="① 发出 Device Bufferable 写 W0、W1&#10;AWCACHE=0001；中间缓冲可以先返回响应。" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fillColor=#dbeafe;strokeColor=#cbd5e1;"><mxGeometry x="30" y="215" width="1020" height="125" as="geometry" /></mxCell><mxCell id="6" parent="1" value="↓" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fontStyle=0;"><mxGeometry x="505" y="340" width="80" height="35" as="geometry" /></mxCell><mxCell id="7" parent="1" value="② 随后发出 Device Non-bufferable 写 W2&#10;AWCACHE=0000；沿用同一 ID，访问同一从设备。" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fillColor=#dbeafe;strokeColor=#cbd5e1;"><mxGeometry x="30" y="375" width="1020" height="125" as="geometry" /></mxCell><mxCell id="8" parent="1" value="↓" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fontStyle=0;"><mxGeometry x="505" y="500" width="80" height="35" as="geometry" /></mxCell><mxCell id="9" parent="1" value="③ 顺序规则约束最终目的地的处理&#10;前序 W0、W1 必须先到达，W2 才能返回响应。" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fillColor=#dcfce7;strokeColor=#cbd5e1;"><mxGeometry x="30" y="535" width="1020" height="125" as="geometry" /></mxCell><mxCell id="10" parent="1" value="↓" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fontStyle=0;"><mxGeometry x="505" y="660" width="80" height="35" as="geometry" /></mxCell><mxCell id="11" parent="1" value="④ 主设备收到 W2 的响应&#10;此时可确认前序 W0、W1 已在最终目的地可见。" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fillColor=#f3e8ff;strokeColor=#cbd5e1;"><mxGeometry x="30" y="695" width="1020" height="125" as="geometry" /></mxCell><mxCell id="12" parent="1" value="W0/W1/W2 是完整写事务名称，不是 W 通道数据拍。&#10;不同 ID 或不同从设备不在此保证范围内。&#10;教学重绘；依据 A4.8、A4.9.1。" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#172b42;fontStyle=0;"><mxGeometry x="30" y="865" width="1020" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>